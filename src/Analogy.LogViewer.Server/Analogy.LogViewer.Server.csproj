<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SpaRoot>..\analogy.logviewer.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:49738</SpaProxyServerUrl>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Analogy.LogViewer.ElasticCommonSchema" />
		<PackageReference Include="Analogy.LogViewer.gRPC" />
		<PackageReference Include="Analogy.LogViewer.Interfaces" />
		<PackageReference Include="Analogy.LogViewer.Intuitive" />
		<PackageReference Include="Analogy.LogViewer.Serilog" />
		<PackageReference Include="Analogy.LogViewer.Template" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\analogy.logviewer.client\analogy.logviewer.client.esproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

</Project>
