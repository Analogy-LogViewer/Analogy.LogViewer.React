<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\analogy.logviewer.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:49738</SpaProxyServerUrl>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Analogy.LogViewer.ElasticCommonSchema" Version="9.0.6.1" />
    <PackageReference Include="Analogy.LogViewer.gRPC" Version="9.0.6" />
    <PackageReference Include="Analogy.LogViewer.Interfaces" Version="9.0.6" />
    <PackageReference Include="Analogy.LogViewer.Intuitive" Version="9.0.8" />
    <PackageReference Include="Analogy.LogViewer.Serilog" Version="9.0.5" />
    <PackageReference Include="Analogy.LogViewer.Template" Version="9.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\analogy.logviewer.client\analogy.logviewer.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
