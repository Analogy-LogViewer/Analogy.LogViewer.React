<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Analogy.LogViewer.ElasticCommonSchema" Version="9.0.6.1" />
		<PackageVersion Include="Analogy.LogViewer.gRPC" Version="9.0.7" />
		<PackageVersion Include="Analogy.LogViewer.Interfaces" Version="9.0.6" />
		<PackageVersion Include="Analogy.LogViewer.Intuitive" Version="9.0.10" />
		<PackageVersion Include="Analogy.LogViewer.Serilog" Version="9.0.5" />
		<PackageVersion Include="Analogy.LogViewer.Template" Version="9.0.6" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
		<PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
		<PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.10" />
	</ItemGroup>
</Project>
